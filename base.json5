{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>UbiqueInnovation/renovate-config-systems:base.json5"
    ],
    "enabledManagers": [
        "ansible",
        "docker-compose",
        "dockerfile",
        "kubernetes",
        "maven",
        "gradle",
        "github-actions",
        "npm",
        "pip_requirements",
        "pep621",
        "ansible-galaxy",
        "custom.regex",
        "pre-commit"
    ],
    // pre-commit is currently still in beta testing
    "pre-commit": {
        "enabled": true
    },
    "customManagers": [
        {
            // Detect Docker image versions used by Testcontainers in Java source files.
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)src/(main|test)/java/.*\\.java$/"
            ],
            "matchStrings": [
                "DockerImageName\\.parse\\(\\s*\"(?<depName>[^\"\\s]+):(?<currentValue>[A-Za-z0-9_][A-Za-z0-9_.-]*)\"\\s*\\)",
                "new\\s+[A-Za-z0-9_$.]+Container(?:\\s*<[^>]*>)?\\s*\\(\\s*\"(?<depName>[^\"\\s]+):(?<currentValue>[A-Za-z0-9_][A-Za-z0-9_.-]*)\"\\s*\\)"
            ],
            "datasourceTemplate": "docker",
            "depTypeTemplate": "testcontainers"
        }
    ],
    "packageRules": [
        // Separate group for Spring Boot and Cloud packages (one group because they have to be compatible versions)
        {
            "matchDatasources": [
                "maven"
            ],
            "groupName": "Spring Boot/Cloud dependencies",
            "matchPackageNames": [
                "org.springframework.boot:spring-boot{/,}**",
                "org.springframework.cloud:spring-cloud{/,}**",
                "com.azure.spring:spring-cloud-azure{/,}**"
            ]
        },
        // These packages are not public, so renovate needs to check the registryUrls below with the credentials at the top
        {
            "matchDatasources": [
                "maven"
            ],
            "groupName": "UB Artifactory dependencies",
            "minimumReleaseAge": "4 hours",
            "registryUrls": [
                "https://artifactory.ubique.ch/artifactory/ubique"
            ],
            "matchPackageNames": [
                "ch.ubique{/,}**",
                "ch.sac.shared:sac{/,}**",
                "ch.admin.swisstopo.shared:swisstopo{/,}**",
                "ch.ethz:eth{/,}**"
            ],
            "excludePackageNames": [
                "/^ch\\.ubique:uetlib.*$/"
            ]
        },
        // Auto-merge patch updates for UB Artifactory dependencies and Spring Boot (except CalVer packages)
        {
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.ubique{/,}**",
                "ch.sac.shared:sac{/,}**",
                "ch.admin.swisstopo.shared:swisstopo{/,}**",
                "ch.ethz:eth{/,}**",
                "org.springframework.boot:spring-boot{/,}**"
            ],
            "excludePackageNames": [
                "ch.ubique:uetlib-bom",
                "ch.ubique:uetlib-spring-boot-starter-parent"
            ],
            "matchUpdateTypes": ["patch"],
            "automerge": true
        },
        {
            "matchPackageNames": [
                "edu.ucar:grib"
            ],
            "allowedVersions": "!/^8\\..*$/"
        },
        {
            "matchPackageNames": [
                "io.kubernetes:client-java"
            ],
            "allowedVersions": "!/^\\d+\\.\\d+\\.\\d+-legacy$/"
        },
        // only non-prerelease versions allowed for commons-cli:commons-cli
        {
            "matchPackageNames": [
                "commons-cli:commons-cli"
            ],
            "allowedVersions": "!/-.+$/"
        },
        // uetlib: separate group, only non-prerelease versions allowed
        {
            "matchDatasources": [
                "maven"
            ],
            "groupName": "uetlib",
            "minimumReleaseAge": "4 hours",
            "registryUrls": [
                "https://artifactory.ubique.ch/artifactory/ubique"
            ],
            "matchPackageNames": [
                "/^ch\\.ubique:uetlib.*$/"
            ],
            "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
        },

        // OUTDATED: backend-jvm-lib has been superseded by uetlib.
        // Migration is intentionally manual because several legacy artifacts
        // do not have a safe one-to-one automated replacement.
        {
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "/^ch\\.ubique:backend-jvm-lib.*$/"
            ],
            "abandonmentThreshold": "1 day"
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "joda-time:joda-time"
            ],
            "abandonmentThreshold": "1 day"
        },
        {
          "matchManagers": ["pep621"],
          "rangeStrategy": "update-lockfile"
        }
    ]
}
